<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Application Icon -->
    <ApplicationIcon>Assets\grow-plant.ico</ApplicationIcon>


    <!-- 32-bit -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>

    <!-- Single EXE -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!-- Bundle native libraries -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Compression -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Compatibility -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
      <Resource Include="Assets\grow-plant.ico" />
  </ItemGroup>
</Project>
