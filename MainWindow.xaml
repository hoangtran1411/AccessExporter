<!-- AccessExporter/MainWindow.xaml -->
<Window x:Class="AccessExporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Access Exporter"
        Height="650"
        Width="1600"
        Icon="/Assets/grow-plant.ico">


        <Window.Resources>
                <!-- Shapes, each drawn in a 10x10 box -->
                <EllipseGeometry x:Key="CircleGeometry"
                                 Center="5,5"
                                 RadiusX="5"
                                 RadiusY="5"/>
                <Geometry x:Key="DiamondGeometry">M 5,0 L 10,5 L 5,10 L 0,5 Z</Geometry>
                <Geometry x:Key="SquareGeometry">M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z</Geometry>
                <Geometry x:Key="TriangleGeometry">M 5,0.5 L 10,9.5 L 0,9.5 Z</Geometry>

                <!-- Common look of every icon (also used by the legend) -->
                <Style x:Key="IconBase"
                       TargetType="Path">
                        <Setter Property="Width"
                                Value="10"/>
                        <Setter Property="Height"
                                Value="10"/>
                        <Setter Property="Stretch"
                                Value="Uniform"/>
                        <Setter Property="VerticalAlignment"
                                Value="Center"/>
                </Style>

                <!-- Icon in the list: shape + color chosen from TableItem.Kind -->
                <Style x:Key="KindIcon"
                       TargetType="Path"
                       BasedOn="{StaticResource IconBase}">
                        <Setter Property="Data"
                                Value="{StaticResource CircleGeometry}"/>
                        <Setter Property="Fill"
                                Value="#2E9E5B"/>
                        <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}"
                                             Value="LinkTable">
                                        <Setter Property="Data"
                                                Value="{StaticResource DiamondGeometry}"/>
                                        <Setter Property="Fill"
                                                Value="#2F7DE1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}"
                                             Value="ViewOrOdbc">
                                        <Setter Property="Data"
                                                Value="{StaticResource SquareGeometry}"/>
                                        <Setter Property="Fill"
                                                Value="#E08A1E"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}"
                                             Value="Procedure">
                                        <Setter Property="Data"
                                                Value="{StaticResource TriangleGeometry}"/>
                                        <Setter Property="Fill"
                                                Value="#8E5BD9"/>
                                </DataTrigger>
                        </Style.Triggers>
                </Style>
        </Window.Resources>

        <DockPanel Margin="12">

                <!-- Legend (declared first, so it sits at the very bottom) -->
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">
                        <Path Style="{StaticResource IconBase}"
                              Data="{StaticResource CircleGeometry}"
                              Fill="#2E9E5B"/>
                        <TextBlock Text="Table"
                                   Margin="4,0,16,0"/>
                        <Path Style="{StaticResource IconBase}"
                              Data="{StaticResource DiamondGeometry}"
                              Fill="#2F7DE1"/>
                        <TextBlock Text="Link table"
                                   Margin="4,0,16,0"/>
                        <Path Style="{StaticResource IconBase}"
                              Data="{StaticResource SquareGeometry}"
                              Fill="#E08A1E"/>
                        <TextBlock Text="View / ODBC (pass-through)"
                                   Margin="4,0,16,0"/>
                        <Path Style="{StaticResource IconBase}"
                              Data="{StaticResource TriangleGeometry}"
                              Fill="#8E5BD9"/>
                        <TextBlock Text="Saved query (may ask for parameters)"
                                   Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Row 1: .mdb file -->
                <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right"
                                Content="Browse..."
                                Padding="12,4"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseFileCommand}"/>
                        <TextBox Text="{Binding MdbPath, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>

                <!-- Row 2: output folder -->
                <DockPanel DockPanel.Dock="Top"
                           Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="Output folder..."
                                Padding="12,4"
                                Margin="8,0,0,0"
                                Command="{Binding BrowseOutputFolderCommand}"/>
                        <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>

                <!-- Row 3: tools -->
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="0,8,0,8">
                        <Button Content="Load tables"
                                Padding="12,4"
                                Command="{Binding LoadTablesCommand}"/>
                        <Button Content="Select all"
                                Padding="12,4"
                                Margin="8,0,0,0"
                                Command="{Binding SelectAllCommand}"/>
                        <Button Content="Select none"
                                Padding="12,4"
                                Margin="8,0,0,0"
                                Command="{Binding SelectNoneCommand}"/>

                        <Separator Margin="12,0"/>

                        <ComboBox Width="80"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding Formats}"
                                  SelectedItem="{Binding SelectedFormat}"/>
                        <CheckBox Content="{Binding SingleFileLabel}"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding SingleFile}"
                                  IsEnabled="{Binding CanChooseSingleFile}"/>

                        <Button Content="Export"
                                Padding="12,4"
                                Margin="16,0,0,0"
                                Command="{Binding ExportCommand}"/>
                        <Button Content="Cancel"
                                Padding="12,4"
                                Margin="8,0,0,0"
                                Command="{Binding ExportCancelCommand}"/>
                        <Button Content="Open output"
                                Padding="12,4"
                                Margin="8,0,0,0"
                                Command="{Binding OpenOutputCommand}"/>
                </StackPanel>

                <!-- Bottom: status + progress -->
                <TextBlock DockPanel.Dock="Bottom"
                           Margin="0,8,0,0"
                           Text="{Binding StatusMessage}"/>
                <ProgressBar DockPanel.Dock="Bottom"
                             Height="14"
                             Margin="0,8,0,0"
                             Maximum="{Binding ProgressMax}"
                             Value="{Binding ProgressValue}"/>

                <!-- Fill: left = search + list, right = SQL box + preview -->
                <Grid>
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left -->
                        <DockPanel Grid.Column="0">
                                <TextBox DockPanel.Dock="Top"
                                         Margin="0,0,0,6"
                                         ToolTip="Search table name"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                                <ListBox ItemsSource="{Binding TablesView}"
                                         SelectedItem="{Binding SelectedTable}">
                                        <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    ToolTip="{Binding Kind}">
                                                                <Path Style="{StaticResource KindIcon}"
                                                                      Margin="0,0,8,0"/>
                                                                <CheckBox IsChecked="{Binding IsSelected}">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                </CheckBox>
                                                        </StackPanel>
                                                </DataTemplate>
                                        </ListBox.ItemTemplate>
                                </ListBox>
                        </DockPanel>

                        <!-- Right -->
                        <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Row="0"
                                         Grid.Column="0"
                                         Height="80"
                                         Margin="0,0,0,6"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         ToolTip="Jet SQL, for example: SELECT TOP 50 * FROM [MyTable]"
                                         Text="{Binding SqlText, UpdateSourceTrigger=PropertyChanged}"/>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="8,0,0,6">
                                        <Button Content="Run SQL"
                                                Padding="12,4"
                                                Command="{Binding RunSqlCommand}"/>
                                        <Button Content="Export result"
                                                Padding="12,4"
                                                Margin="0,6,0,0"
                                                Command="{Binding ExportCommand}"
                                                CommandParameter="sql"/>
                                </StackPanel>

                                <DataGrid Grid.Row="1"
                                          Grid.Column="0"
                                          Grid.ColumnSpan="2"
                                          ItemsSource="{Binding PreviewData}"
                                          IsReadOnly="True"
                                          AutoGenerateColumns="True"
                                          CanUserAddRows="False"/>
                        </Grid>
                </Grid>

        </DockPanel>
</Window>